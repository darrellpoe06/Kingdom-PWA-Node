{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Claude_Code_Remote__send_later|ScheduleWakeup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/cadence-guard-pretool-hook.mjs\""
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/context-hygiene-pretool-hook.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/required-reading-pretool-hook.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ari-guard-stop-hook.mjs\""
          }
        ]
      }
    ]
  }
}