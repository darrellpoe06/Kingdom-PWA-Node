        0
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of items) {\n  let parsed = [];\n  try { parsed = JSON.parse((item.json.stdout || '[]').trim() || '[]'); } catch (e) { parsed = []; }\n  out.push({ json: { messages: Array.isArray(parsed) ? parsed : [] } });\n}\nreturn out;"
      }
