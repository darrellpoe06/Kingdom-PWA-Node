{
  "id": "wfPropPhotos001",
  "name": "wf-property-photos",
  "nodes": [
    {
      "id": "ppWebhook1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "b3e8d2a1-6f47-4c92-a05e-1d9c7b2f4a60",
      "position": [0, 0],
      "parameters": {
        "httpMethod": "GET",
        "path": "property-photos",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "phbridgetoken1", "name": "property-history bridge token" }
      }
    },
    {
      "id": "ppArgs1",
      "name": "Build args",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "const j = (items[0] && items[0].json) || {};\nconst q = j.query || (j.params && j.params.query) || {};\nconst ch = String(q.channel || '').replace(/[^A-Za-z0-9._-]/g, '') || 'none';\nconst lim = Math.max(1, Math.min(48, parseInt(q.limit, 10) || 24));\nconst off = Math.max(0, parseInt(q.offset, 10) || 0);\nreturn [{ json: { cmd: `photos ${ch} ${lim} ${off}` } }];"
      }
    },
    {
      "id": "ppSsh1",
      "name": "Read channel photos",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [440, 0],
      "parameters": {
        "authentication": "privateKey",
        "command": "={{ $json.cmd }}"
      },
      "credentials": {
        "sshPrivateKey": { "id": "phphotosssh1", "name": "property-photos bridge key" }
      }
    },
    {
      "id": "ppCode1",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of items) {\n  let parsed = { count: 0, photos: [] };\n  try { parsed = JSON.parse((item.json.stdout || '').trim() || '{}'); } catch (e) { parsed = { count: 0, photos: [], error: 'parse' }; }\n  out.push({ json: parsed });\n}\nreturn out;"
      }
    },
    {
      "id": "ppResp1",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [880, 0],
      "parameters": { "respondWith": "allIncomingItems", "options": {} }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Build args", "type": "main", "index": 0 }]] },
    "Build args": { "main": [[{ "node": "Read channel photos", "type": "main", "index": 0 }]] },
    "Read channel photos": { "main": [[{ "node": "Parse JSON", "type": "main", "index": 0 }]] },
    "Parse JSON": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
