# =============================================================================
# Stack B environment — copy to .env (never commit .env)
# =============================================================================
# After copying, generate the encryption key with:
#   openssl rand -hex 32
# Or in PowerShell:
#   -join ((48..57 + 97..102) | Get-Random -Count 64 | % {[char]$_})
#
# Set N8N_HOST + WEBHOOK_URL + NTFY_BASE_URL to the Synology's Tailscale IP
# (run `tailscale ip -4` on the DS1621xs) or its Tailscale MagicDNS hostname.
# =============================================================================

# n8n credential encryption key. CHANGE THIS — losing it loses every credential
# stored in n8n. Back it up in your password manager.
N8N_ENCRYPTION_KEY=replace-me-with-openssl-rand-hex-32

# Tailscale IP or hostname of the Synology. Examples:
#   N8N_HOST=100.x.y.z
#   N8N_HOST=poetech.taila1b2c.ts.net
N8N_HOST=replace-with-tailscale-ip-or-hostname
WEBHOOK_URL=http://replace-with-tailscale-ip-or-hostname:5678/
NTFY_BASE_URL=http://replace-with-tailscale-ip-or-hostname:8081

# --- Pushover dual-path notification (added 2026-05-26 after pomail re-read) -
# Two paths to deliver pushes; workflows pick at runtime via an If node.
# Values for Darrell's account live in infra/n8n/.pushover-creds.local
# (gitignored). Confirmed 2026-05-26 from his Pushover Settings screenshot.
#
#   Path A - Direct API (richer): POST to api.pushover.net with user_key +
#   app_token. Supports priorities, sounds, attachments, custom URLs,
#   target-device routing. ACTIVE when PUSHOVER_APP_TOKEN is set + non-empty.
#
#   Path B - Email-to-push (uses what we already have): SMTP-send to
#   PUSHOVER_EMAIL_GATEWAY (e.g. ikzf7xijr4@pomail.net). Pushover converts
#   inbound emails into pushes. Subject -> title, body -> message. Less rich
#   but works the moment any SMTP source is wired up (Resend, Gmail relay,
#   etc.) - NO Pushover app token needed.
#
# Day-1 posture: Path B operational the moment SMTP credentials land in n8n.
# Path A goes live the moment Darrell creates the app token at
# https://pushover.net/apps/build and pastes it here.
#
# Account is on a 30-day free trial as of 2026-05-26. $5 lifetime license
# must be purchased by 2026-06-25 - see seeded change_request
# "Pushover license $5 one-time" (priority bumped to reflect deadline).
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_EMAIL_GATEWAY=
PUSHOVER_DEVICE_NAME=PoeTech

# --- Ollama quad-model architecture (expanded 2026-05-26 after 62 GB RAM finding) ----
# Four models loaded simultaneously - all local, all $0/mo perpetual. Total
# resident at full load: ~16 GB (well under the 24 GB Ollama container cap;
# host has 62 GB physical so plenty of headroom for n8n + ntfy + app + DSM).
#
#   PRIMARY (routing/digest, fast):
#     qwen2.5:3b-instruct-q4_K_M       ~2 GB resident, 10-15 tok/sec CPU
#     Used for: n8n daily-digest summarization, banned-language audit,
#     classification, short-context routing. Latency > depth.
#
#   SECONDARY (deep reasoning, chain-of-thought):
#     deepseek-r1:8b-llama-distill-q4_K_M    ~5 GB resident, 3-5 tok/sec CPU
#     Used for: chain-of-thought analysis of change_requests, trade-off
#     weighing in projects, multi-step reasoning over Scripture-grounded inputs.
#
#   TERTIARY (Counseling four-section response, general chat):
#     qwen2.5:14b-instruct-q4_K_M      ~9 GB resident, 2-3 tok/sec CPU
#     Used for: Counseling sub-tab four-section responses (DATA -> TRUTH ->
#     IDENTITY -> INVITATION), discipleship dialogue, anything where the
#     quality bar is "you'd hand this to a parishioner." Slow (~3-4 min for a
#     500-token reply) but Counseling is journal-style, not chat.
#
#   EMBEDDING (RAG over Scripture + family docs):
#     nomic-embed-text                 ~280 MB resident, near-instant
#     Used for: pgvector embeddings - Scripture search, family-note retrieval,
#     change_request similarity. Industry-standard for RAG.
#
# Workflows pick which model via the env vars below in the n8n HTTP Request
# body - never hardcode the model tag. That way swapping a model only changes
# .env, not every workflow JSON.
#
# OLLAMA_MAX_LOADED_MODELS=4 in docker-compose.yml keeps all four resident.
# Memory cap on the Ollama container is 24 GB (62 GB physical - 24 = 38 GB
# left for n8n + ntfy + app + DSM, which fit in ~6 GB combined).
#
# Future room: a 70B Q4 (~40 GB resident) is viable when needed - bump the
# container cap to 45g and OLLAMA_MAX_LOADED_MODELS to 5.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_SECONDARY_MODEL=deepseek-r1:8b-llama-distill-q4_K_M
OLLAMA_TERTIARY_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
