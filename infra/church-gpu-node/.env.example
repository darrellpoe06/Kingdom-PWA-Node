# Church GPU node -- copy to .env, fill, never commit. ASCII only.

# Persistence root for model weights (bind mounts, per PERPETUAL-PIPELINE-HEALTH).
# Windows/WSL2: use a WSL path, e.g. /mnt/c/poetech/gpu-node/data
# Linux: an absolute path on a real disk, e.g. /srv/poetech/gpu-node/data
DATA_ROOT=./data

# Media folder the harvest no-caption fallback transcribes by { "path": ... }.
# Point this at where service recordings land (mounted read-only into whisper-gpu
# at /work). One-off clips can still be uploaded multipart without this.
MEDIA_ROOT=./media

# --- Optional model overrides (sensible defaults in the compose) -------------
# Daily reasoner that fits a 4070's 12 GB at Q4 (DR-0012). Do NOT set 32B+ here.
# OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
# XTTS voice model (default is XTTS-v2).
# VOICE_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Transcription model (turbo = 8x faster decode, batch-fast on GPU).
# WHISPER_MODEL=large-v3-turbo
