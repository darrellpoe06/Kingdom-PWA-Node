# church-runner environment template. Copy to .env and edit on the box.
# .env is NOT committed (see .gitignore) -- it is the only per-site config seam.
# Nothing here arms the runner; arming is done with the flag files in ./state.

TZ=America/Chicago

# --- Cage brakes ------------------------------------------------------------
# Step budget: the probe runs at most this many read-only checks per fire. 0 =
# unset = a missing brake = INERT (the shipped default). The lan-targets.json
# registry currently lists 8 devices, so 8 is the natural armed value.
PROBE_MAX_STEPS=0
# Per-step timeout (seconds) for each read-only probe.
PROBE_TIMEOUT_SEC=3
# $ budget -- the DISPATCH tier only (sending work to a GPU tower / summoning an
# LLM worker). The read-only probe never spends. Leave at 0 until that tier is
# separately designed + armed (Tier C, his hand, someone watching).
BUDGET_PER_TASK_USD=0
BUDGET_DAILY_USD=0

# --- Probe wiring (fill from the COLG device asset register) ----------------
# Read-only UniFi controller API key, attached at runtime (NEVER committed). The
# controller URL lives in lan-targets.json (unifi-controller.ip / .url).
UNIFI_API_KEY=
# Optional override of the targets file path.
# TARGETS_FILE=/app/lan-targets.json
