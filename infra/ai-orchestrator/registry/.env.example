# Sovereign AI Registry (NAS) — copy to .env and fill. Never commit the real .env.
# ASCII only.

# Bind Postgres to the NAS Tailscale IP (e.g. 100.x.x.x). 127.0.0.1 = local-only.
REGISTRY_BIND_IP=127.0.0.1

# Database + privileged owner role (DDL, migrations).
POSTGRES_DB=poetech_registry
POSTGRES_USER=registry_owner
POSTGRES_PASSWORD=change_me_long_random

# Least-privilege role the AI agent / n8n connect as. 001-audit-ledger.sql grants
# this role INSERT + SELECT on the ledger only (no UPDATE/DELETE).
AI_AGENT_PASSWORD=change_me_long_random_too
