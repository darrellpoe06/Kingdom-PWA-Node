# Sovereign AI Orchestrator -- Node 1 (Legion PC). Copy to .env, fill, never commit.
# ASCII only.

# Persistence root (bind mounts, per PERPETUAL-PIPELINE-HEALTH). On Windows/WSL2
# use a WSL path, e.g. /mnt/c/poetech/ai-orchestrator, or leave ./data for a
# folder beside this compose file.
DATA_ROOT=./data

# --- n8n ---------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change_me_long_random
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# --- NAS Master Registry (Postgres, over Tailscale) --------------------------
REGISTRY_HOST=100.x.x.x          # NAS Tailscale IP
REGISTRY_PORT=5432
REGISTRY_DB=poetech_registry
# n8n's own DB role (create on the registry; separate from the append-only
# ai_agent role used by the Cage).
REGISTRY_N8N_USER=n8n_app
REGISTRY_N8N_PASSWORD=change_me_long_random

# --- Models ------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ARCHITECT_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_CODER_MODEL=qwen2.5-coder:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
