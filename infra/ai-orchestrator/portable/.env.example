# Portable PoeTech Orchestrator -- copy to .env, fill, never commit. ASCII only.
# Every value here has a safe default in docker-compose.yml; .env only overrides.

# --- Identity ----------------------------------------------------------------
TZ=America/Chicago
NODE_NAME=portable-node          # name this NAS so the event log identifies it
AGENT_NAME=orchestrator

# --- Heartbeat ---------------------------------------------------------------
HEARTBEAT_SECONDS=30             # how often the inert supervisor logs a heartbeat

# --- Budget brake (per-task + daily $ ceiling for any vendor-LLM summoning) ---
# 0 = UNSET = treated as a MISSING brake -> the orchestrator stays inert even if
# armed. Set BOTH to real positive ceilings before arming autonomy (later).
BUDGET_PER_TASK_USD=0
BUDGET_DAILY_USD=0

# --- Bounded auto-resume (scripts/cap-resume.mjs) ----------------------------
# Resumes ONLY the explicitly-approved queue (state/approved-queue.json) after the
# vendor cap resets. See resume/RESUME-CONTRACT.md. Ships INERT: caps 0 = MISSING
# brake -> inert even if armed; arming also needs ./resume-arm.sh (RESUME_ARMED).

# Count half of the budget brake (the $ half is BUDGET_* above). Both > 0 required.
RESUME_MAX_TASKS_PER_RUN=0       # hard cap: tasks resumed in one scheduler fire
RESUME_MAX_CALLS_PER_DAY=0       # hard cap: vendor API calls per day

# Cap-reset window (the NAS poll resumes only once local time passes reset+buffer).
CAP_RESET_LOCAL=04:30            # vendor daily cap reset, local wall time (HH:MM)
CAP_RESET_TZ=America/Chicago     # timezone the reset time is expressed in
CAP_RESET_BUFFER_MIN=10          # wait this many minutes past reset before resuming

# Observability alert (optional; best-effort). Unset = event-log only.
NTFY_URL=                        # e.g. http://localhost:8081
NTFY_TOPIC=                      # e.g. darrell
