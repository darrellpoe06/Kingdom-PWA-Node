{
  "name": "01 · Supabase cycle_item insert → Pushover (dual-path) + ntfy",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "supabase-cycle-item",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-01",
      "name": "Supabase Webhook (cycle_items.insert)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [120, 320],
      "webhookId": "supabase-cycle-item"
    },
    {
      "parameters": {
        "jsCode": "// Supabase webhook payload shape:\n//   { type: 'INSERT', table: 'cycle_items', record: {...}, schema: 'public', old_record: null }\n// POE binding: dispositions stay pending/approved/deferred-next-cycle — never 'rejected'.\nconst input = $input.first().json;\nconst record = input.body?.record || input.record || {};\n\nconst title = record.title || 'New cycle item';\nconst assignee = record.assigned_to || 'unassigned';\nconst priority = record.priority_score ?? null;\nconst override = record.user_priority_override ?? null;\nconst cycle = record.cycle_id || 'current cycle';\nconst itemId = record.id || '';\n\n// Route to Darrell (Pushover dual-path) vs family (ntfy).\nconst routeToDarrell = (assignee || '').toLowerCase().includes('darrell');\n\nconst priorityNote = override !== null\n  ? `Your override: ${override}.`\n  : (priority !== null ? `Suggested priority: ${priority}.` : 'Priority pending.');\n\nconst notifTitle = `Cycle item · ${title}`;\nconst notifBody = [\n  `New item ready for your prayer: \"${title}\"`,\n  `Assigned: ${assignee} · Cycle: ${cycle}`,\n  priorityNote,\n  'Disposition stays pending until you weigh in.'\n].join('\\n');\nconst url = `https://kingdom-pwa-node.vercel.app/?cycle_item=${itemId}`;\n\nreturn [{\n  json: {\n    routeToDarrell,\n    title: notifTitle,\n    body: notifBody,\n    pushover: { title: notifTitle, message: notifBody, priority: 0, url_title: 'Open in PoeTech', url },\n    email:    { subject: notifTitle, text: notifBody + '\\n\\n' + url },\n    ntfy: { topic: 'family-ops', title: notifTitle, message: notifBody, tags: ['pray', assignee.toLowerCase()], click: url }\n  }\n}];"
      },
      "id": "node-format-01",
      "name": "Format notification (POE-bound)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-route-darrell",
              "leftValue": "={{ $json.routeToDarrell }}",
              "rightValue": true,
              "operator": {"type": "boolean", "operation": "true", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-route-01",
      "name": "Route: Darrell vs family",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-token-01",
              "leftValue": "={{ $env.PUSHOVER_APP_TOKEN }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-token-01",
      "name": "PUSHOVER_APP_TOKEN set? (Path A vs B)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.pushover.net/1/messages.json",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {"name": "token", "value": "={{ $env.PUSHOVER_APP_TOKEN }}"},
            {"name": "user", "value": "={{ $env.PUSHOVER_USER_KEY }}"},
            {"name": "device", "value": "={{ $env.PUSHOVER_DEVICE_NAME }}"},
            {"name": "title", "value": "={{ $json.pushover.title }}"},
            {"name": "message", "value": "={{ $json.pushover.message }}"},
            {"name": "priority", "value": "={{ $json.pushover.priority }}"},
            {"name": "url_title", "value": "={{ $json.pushover.url_title }}"},
            {"name": "url", "value": "={{ $json.pushover.url }}"}
          ]
        },
        "options": {}
      },
      "id": "node-pushover-01",
      "name": "Path A · Pushover Direct API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 80]
    },
    {
      "parameters": {
        "fromEmail": "darrellpoe06@gmail.com",
        "toEmail": "={{ $env.PUSHOVER_EMAIL_GATEWAY }}",
        "subject": "={{ $json.email.subject }}",
        "text": "={{ $json.email.text }}",
        "options": {}
      },
      "id": "node-email-01",
      "name": "Path B · Email-to-push (pomail)",
