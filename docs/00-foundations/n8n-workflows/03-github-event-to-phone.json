{
  "name": "03 · GitHub event (commit/PR) → Pushover (dual-path)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-events",
        "responseMode": "responseNode",
        "options": {"rawBody": false}
      },
      "id": "node-webhook-03",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [120, 320],
      "webhookId": "github-events"
    },
    {
      "parameters": {
        "jsCode": "// GitHub webhook payloads we care about: push, pull_request, ping.\n// X-GitHub-Event header tells us which one.\nconst headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || $input.first().json || {};\nconst event = (headers['x-github-event'] || '').toLowerCase();\n\nconst repo = body.repository?.full_name || 'unknown-repo';\nlet title, message, url;\n\nif (event === 'push') {\n  const ref = (body.ref || '').replace('refs/heads/', '');\n  const pusher = body.pusher?.name || body.sender?.login || 'someone';\n  const commits = body.commits || [];\n  const head = commits[commits.length - 1] || {};\n  const shortMsg = (head.message || '').split('\\n')[0].slice(0, 140);\n  title = `${repo} · push to ${ref}`;\n  message = `${pusher}: ${shortMsg || '(no message)'}\\n${commits.length} commit(s).`;\n  url = head.url || body.compare || body.repository?.html_url || '';\n} else if (event === 'pull_request') {\n  const pr = body.pull_request || {};\n  const action = body.action || 'updated';\n  title = `${repo} · PR ${action}`;\n  message = `#${pr.number || '?'}: ${pr.title || '(no title)'}\\nby ${pr.user?.login || 'someone'} · state ${pr.state}`;\n  url = pr.html_url || '';\n} else if (event === 'ping') {\n  title = `${repo} · webhook ping`;\n  message = 'GitHub successfully reached n8n.';\n  url = body.repository?.html_url || '';\n} else {\n  return [{ json: { skip: true, event } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    title,\n    body: message,\n    pushover: { title, message, priority: 0, url, url_title: 'View on GitHub' },\n    email:    { subject: title, text: message + (url ? '\\n\\n' + url : '') }\n  }\n}];"
      },
      "id": "node-format-03",
      "name": "Parse GitHub event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-skip",
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": {"type": "boolean", "operation": "false", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-skip-03",
      "name": "Skip noisy events",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"},
          "conditions": [
            {
              "id": "cond-token-03",
              "leftValue": "={{ $env.PUSHOVER_APP_TOKEN }}",
              "rightValue": "",
              "operator": {"type": "string", "operation": "notEmpty", "singleValue": true}
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-token-03",
      "name": "PUSHOVER_APP_TOKEN set? (Path A vs B)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.pushover.net/1/messages.json",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
