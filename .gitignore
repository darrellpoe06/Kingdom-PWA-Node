# ============================================================================
# Repo-root .gitignore
# ============================================================================
# The app/ subproject has its own .gitignore for node_modules, dist, .vite.
# This file covers the repo root.

# ----------------------------------------------------------------------------
# Sensitive / PII / PHI material — never commit
# ----------------------------------------------------------------------------
# Local Drive review folders. May contain onboarding forms with licenses,
# NPI, DEA, bank routing/account, I-9, driver's license — keep out of repo.
drive-download-*/
drive-download-*.zip

# Real bank/CSV exports, transaction dumps, scanned IDs, signed agreements.
# Use the patterns below to add safety even when files are dropped ad hoc.
*statements*.csv
*statements*.xlsx
*-real-*.csv
/private/

# ----------------------------------------------------------------------------
# Editor / OS noise
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# ----------------------------------------------------------------------------
# Environment / secrets — defense in depth (real secrets go in Cloudflare
# Wrangler secrets or a local .dev.vars file, never in the repo)
# ----------------------------------------------------------------------------
.env
.env.*
.dev.vars
*.pem
*.key
secrets.json
credentials.json
# Exception: .env.example files ARE templates and MUST be committed so a
# fresh clone knows what env vars exist. Same for .env.sample / .env.template.
# Added 2026-05-26 after Phase 1c add-batch failed on infra/n8n/.env.example.
!**/.env.example
!**/.env.sample
!**/.env.template

# ----------------------------------------------------------------------------
# Logs
# ----------------------------------------------------------------------------
*.log

# Claude Code local config — never commit
.claude/

# Supabase self-hosted — secrets and data volumes never committed
infra/supabase/.env
infra/supabase/.secrets-summary.txt
infra/supabase/volumes/db/data/
infra/supabase/volumes/storage/

# Vite local env files — Supabase URL/key (publishable but still kept out of git)
app/.env.local
app/.env.*.local

# Stale / experimental build outputs — only app/dist is the canonical artifact
app/dist-*/

# ----------------------------------------------------------------------------
# Working-directory cruft (added 2026-05-28)
# One-off PowerShell / batch scripts from earlier sessions, installer binaries,
# and git format-patch artifacts. None of these belong in source control.
# ----------------------------------------------------------------------------
# Git format-patch artifacts
*.patch
# Installers + binary packages (Claude desktop, Synology Drive Client, etc.)
*.exe
*.deb
*.msi
*.dmg
*.pkg
# One-off helper scripts dated by session — keep at root for the session that
# created them, never commit. Excludes infra/n8n/scripts/* which is canonical.
/auto-commit-*.ps1
/commit-*.ps1
/restore-*.ps1
/restore-*.bat
/_restore-*.ps1
/_restore-*.bat
/ship-*.ps1
/stage-*.ps1
/run-*.ps1
/push-*.ps1
/setup-*.ps1
/deploy-*.ps1
/apply-*.ps1
# Sandbox test artifacts
docs/.sandbox-write-test.md
# Root-level read-aloud HTML (the canonical one is app/public/read-aloud.html)
/read-aloud.html

# Generated backfill artifacts
scripts/out/
