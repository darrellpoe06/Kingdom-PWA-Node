# Cloudflare Pages response headers — mirrors BOTH the security headers AND the
# cache policy in app/vercel.json. After the Vercel -> Cloudflare cutover, this
# file is the ONLY place response headers are set; anything not listed here is
# simply not served. The security block below is therefore at exact parity with
# the vercel.json `headers` block (CSP, HSTS, clickjacking + MIME guards) so the
# move to Cloudflare does not silently drop the app's defense-in-depth.
# Parity is gated by app/src/__tests__/security-headers-guard.test.js.
#
# Rules match the INCOMING request path (/poetech-app/...), before the _redirects
# rewrite to root.
#
# IMPORTANT: Cloudflare COMBINES (concatenates) the headers of EVERY matching
# rule — it does not "most-specific-wins". So a broad `/poetech-app/*` no-store
# rule would also stamp no-store onto the hashed bundles and defeat their
# immutable caching. The cache rules below are therefore NON-OVERLAPPING: assets
# get immutable only; the shell files get no-store only. The security `/*` block
# carries NO Cache-Control, so it composes cleanly with the cache rules below
# (every path gets the security headers; cache behavior is unchanged).

# Security headers for every response (parity with vercel.json "/(.*)" block).
# CSP value MUST stay byte-identical to vercel.json's Content-Security-Policy.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https:; media-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), payment=(), usb=(), browsing-topics=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-DNS-Prefetch-Control: off

# Content-hashed bundles: cache forever (the filename changes every build).
/poetech-app/assets/*
  Cache-Control: public, max-age=31536000, immutable

# App shell (navigation request resolves to index.html): never cache —
# iOS Safari over-caches HTML and would strand the user on an old bundle.
/poetech-app/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/poetech-app/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Service worker: never cache, so a new deploy's worker is always picked up.
/poetech-app/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# PWA manifest: never cache so install metadata stays current.
/poetech-app/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

# The Love Corner app shell (DR-0258 — the church's own install scope at
# /lovecorner/app/): same no-store rule as the PoeTech shell, for the same
# iOS-Safari-over-caches-HTML reason. Assets are shared (/poetech-app/assets/*,
# already immutable above).
/lovecorner/app/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/lovecorner/app/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# The church manifest: never cache — its id/scope ARE the install identity.
/manifest-lovecorner.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

# Moore Divahs + TLC app shells and manifests (DR-0261 — same scope-split
# pattern as the church above; same no-store reasons).
/moore/app/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/moore/app/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/tlc/app/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/tlc/app/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest-moore.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/manifest-tlc.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
