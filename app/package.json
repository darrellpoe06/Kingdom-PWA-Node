{
  "name": "poe-financial-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "charter:gen": "node ../scripts/generate-charter.mjs",
    "charter:check": "node ../scripts/generate-charter.mjs --check",
    "legibility": "node ../scripts/legibility-guard.mjs --check",
    "legibility:health": "node ../scripts/legibility-guard.mjs --health",
    "legibility:baseline": "node ../scripts/legibility-guard.mjs --generate",
    "icons": "node ../scripts/gen-icons.mjs",
    "verify": "npm run lint && vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "libsodium-wrappers": "^0.8.4",
    "node-forge": "^1.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@twemoji/svg": "^15.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
